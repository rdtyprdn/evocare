APP_NAME=EvoCare
# Untuk server produksi wajib APP_ENV=production dan APP_DEBUG=false.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

# Proxy yang dipercaya untuk header X-Forwarded-*. Bawaan * (semua), diperlukan
# saat lewat Cloudflare Tunnel. Bisa diisi daftar IP atau CIDR dipisah koma,
# atau dikosongkan agar tidak ada proxy yang dipercaya.
TRUSTED_PROXIES=*

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# 3306 adalah port bawaan MySQL (XAMPP, Laragon, server). MAMP di Mac memakai 8889
# dengan user root dan password root. Di XAMPP password root biasanya kosong.
DB_PORT=3306
DB_DATABASE=evocare
DB_USERNAME=root
DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Email dikirim lewat antrian. Dengan "database", jalankan `php artisan queue:work`
# (atau `composer run dev`, yang sudah ikut menjalankan antrian). Pakai "sync" untuk
# mengirim langsung tanpa worker.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Pengiriman email.
# - log: email tidak dikirim, isinya dicatat di storage/logs/laravel.log (bawaan, cocok untuk lokal).
# - resend: email sungguhan lewat API Resend (HTTPS port 443, tetap jalan walau port SMTP diblokir).
#   Isi RESEND_API_KEY dengan API key dari dashboard Resend, jangan di-commit.
#   MAIL_FROM_ADDRESS=onboarding@resend.dev hanya bisa mengirim ke email pemilik akun Resend.
#   Untuk mengirim ke siapa saja, verifikasi domain di Resend lalu pakai alamat dari domain itu.
# MAIL_MAILER=resend
# RESEND_API_KEY=
# MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
